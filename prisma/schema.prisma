generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  profile       Profile?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Profile {
  id                String      @id @default(cuid())
  userId            String      @unique
  user              User        @relation(fields: [userId], references: [id])
  username          String      @unique
  displayName       String
  fullName          String?
  nickname          String?
  birthDate         DateTime?
  city              String?
  state             String?
  
  parentName        String?
  parentPhone       String?

  jerseyNumber      String?
  position          String?
  secondaryPosition String?
  
  height            Float?
  weight            Float?
  preferredFoot     String? // Destro, Canhoto, Ambidestro
  characteristics   String[]

  currentClub       String?
  history           String?   @db.Text // Trajetória e conquistas

  bio               String?
  avatarUrl         String?
  heroImageUrl      String?
  youtubeUrl        String?
  
  theme             ThemeConfig?
  stats             Stats?
  links             Link[]
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model ThemeConfig {
  id              String  @id @default(cuid())
  profileId       String  @unique
  profile         Profile @relation(fields: [profileId], references: [id])
  primaryColor    String  @default("#DCFF1E")
  secondaryColor  String  @default("#ffffff")
  backgroundColor String  @default("#121414")
}

model Stats {
  id        String  @id @default(cuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id])
  
  // Season metrics
  goals     Int     @default(0)
  assists   Int     @default(0)
  matches   Int     @default(0)
  
  // Performance attributes (0-99)
  pace      Int     @default(0)
  shooting  Int     @default(0)
  passing   Int     @default(0)
  dribbling Int     @default(0)
  defending Int     @default(0)
  physical  Int     @default(0)
}

model Link {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])
  title     String
  url       String
  icon      String?
  imageUrl  String?
  order     Int     @default(0)
}
