generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  profile   Profile?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id])
  username     String      @unique
  displayName  String
  jerseyNumber String?
  position     String?
  bio          String?
  avatarUrl    String?
  heroImageUrl String?
  
  theme        ThemeConfig?
  stats        Stats?
  links        Link[]
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ThemeConfig {
  id              String  @id @default(cuid())
  profileId       String  @unique
  profile         Profile @relation(fields: [profileId], references: [id])
  primaryColor    String  @default("#DCFF1E")
  secondaryColor  String  @default("#ffffff")
  backgroundColor String  @default("#121414")
}

model Stats {
  id        String  @id @default(cuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id])
  
  // Season metrics
  goals     Int     @default(0)
  assists   Int     @default(0)
  
  // Performance attributes (0-99)
  pace      Int     @default(0)
  shooting  Int     @default(0)
  passing   Int     @default(0)
  dribbling Int     @default(0)
  defending Int     @default(0)
  physical  Int     @default(0)
}

model Link {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])
  title     String
  url       String
  icon      String?
  order     Int     @default(0)
}
